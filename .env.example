# ===========================================
# Aether CLI Configuration
# ===========================================
# Copy this file to .env and fill in your keys

# --- API Keys (at least one is required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Default Model ---
# Examples:
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-20250514
#   xai/grok-3
#   gemini/gemini-2.0-flash
AETHER_MODEL=openai/gpt-4o

# --- Optional Settings ---
# AETHER_MAX_TOKENS=4096
# AETHER_TEMPERATURE=0.2
# AETHER_SYSTEM_PROMPT=You are Aether, an expert coding assistant.
